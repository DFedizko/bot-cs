# One of: test | development | production. development and test log bids instead of placing them.
NODE_ENV=development
# Your CSGOEmpire API key.
CSGOEMPIRE_API_KEY=
# Port of the HTTP API that adds, edits and removes wanted items (e.g. 3000).
HTTP_PORT=3000
# Optional. Steam logins used to accept delivered items, one per CSGOEmpire account, as a JSON array:
# [{"accountId":123456,"username":"steam-login","password":"...","sharedSecret":"...","identitySecret":"..."}]
# accountId is your CSGOEmpire user id. sharedSecret and identitySecret come from your mobile authenticator files.
# Never commit or share these values.
STEAM_ACCOUNTS=
