{
    "name": "web",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite dev --port 5173 --strictPort",
        "build": "vite build",
        "preview": "vite preview",
        "routes": "tsr generate",
        "typecheck": "tsr generate && tsc --noEmit",
        "test": "tsr generate && bun test",
        "lint": "tsr generate && eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
        "test:e2e": "playwright test",
        "api:types": "openapi-typescript ${BOT_API_URL:-http://localhost:3000}/openapi.json -o src/shared/api/bot-api.ts"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.3.5",
        "@tanstack/react-devtools": "0.10.15",
        "@tanstack/react-query": "^5.108.3",
        "@tanstack/react-query-devtools": "^5.108.3",
        "@tanstack/react-router": "1.170.46",
        "@tanstack/react-router-devtools": "1.167.4",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwindcss": "^4.3.5"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "^21.0.4",
        "@playwright/test": "^1.65.1",
        "@tanstack/devtools-vite": "0.8.7",
        "@tanstack/eslint-config": "0.5.0",
        "@tanstack/eslint-plugin-query": "^5.108.3",
        "@tanstack/router-cli": "^1.168.0",
        "@tanstack/router-plugin": "1.169.0",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^8.0.0",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.13",
        "@types/bun": "^1.4.5",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "eslint": "^10.15.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-boundaries": "^7.4.4",
        "eslint-plugin-react-hooks": "^7.1.1",
        "msw": "^2.15.0",
        "openapi-msw": "^2.1.1",
        "openapi-typescript": "^7.13.0",
        "prettier": "^3.10.1",
        "typescript": "^7.0.2",
        "typescript-for-eslint": "npm:typescript@6.0.3",
        "vite": "^8.3.8"
    }
}
